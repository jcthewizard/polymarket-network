# Copy this to .env and fill in your keys

# Optional throttling knobs to reduce 429s
OPENAI_REQS_PER_SEC=1.2
OPENAI_BURST_SIZE=3
CLOB_REQS_PER_SEC=2.0
CLOB_BURST_SIZE=4
GAMMA_REQS_PER_SEC=2.0
GAMMA_BURST_SIZE=4

# Hosting / persistence
PORT=8000
DB_PATH=data/polymarket.db
AUTO_REFRESH=1
REFRESH_INTERVAL=600
ENABLE_LLM_CLASSIFICATION=1
MAX_MARKETS_STORE=500
MAX_MARKETS_CORRELATE=200

# Optional LLM batching knobs for discover/backtest workers
LLM_MAX_RETRIES=6
DISCOVER_LLM_BATCH_SIZE=50
BACKTEST_LLM_BATCH_SIZE=50

# === API Keys ===
OPENAI_API_KEY=your-openai-api-key-here

# Polymarket execution layer (optional - only needed for live trading)
POLY_PRIVATE_KEY=your-polygon-private-key-here

# === Trading Mode ===
# dry_run = orders logged but NOT posted (default)
# live = real money trading
TRADING_MODE=dry_run
TRADING_ENABLED=false

# === Trade Sizing ===
BET_SIZE_USDC=1.00

# === Polling Intervals (seconds) ===
TRACKER_POLL_INTERVAL=10
POSITION_POLL_INTERVAL=5
FILL_CHECK_INTERVAL=10

# === Position Management ===
POSITION_EXIT_SECONDS=180
STALE_ORDER_SECONDS=60
SELL_DISCOUNT_PCT=0.02
