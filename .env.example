# Copy this to .env and fill in your API key
OPENAI_API_KEY=your-openai-api-key-here

# Optional throttling knobs to reduce 429s
OPENAI_REQS_PER_SEC=1.2
OPENAI_BURST_SIZE=3
CLOB_REQS_PER_SEC=2.0
CLOB_BURST_SIZE=4
GAMMA_REQS_PER_SEC=2.0
GAMMA_BURST_SIZE=4

# Optional LLM batching knobs for discover/backtest workers
LLM_MAX_RETRIES=6
DISCOVER_LLM_BATCH_SIZE=50
BACKTEST_LLM_BATCH_SIZE=50

# Polymarket execution layer (optional — only needed for live trading)
POLY_PRIVATE_KEY=your-polygon-private-key-here
