# Copy this to .env and fill in your keys

# === API Keys ===
OPENAI_API_KEY=your-openai-api-key-here
POLY_PRIVATE_KEY=your-polygon-private-key-here

# === Trading Mode ===
# dry_run = orders logged but NOT posted (default)
# live = real money trading
TRADING_MODE=dry_run
# TRADING_ENABLED=false  # auto-start on server boot

# === Trade Sizing ===
# BET_SIZE_USDC=1.00

# === Polling Intervals (seconds) ===
# TRACKER_POLL_INTERVAL=10
# POSITION_POLL_INTERVAL=5

# === Position Management ===
# POSITION_EXIT_SECONDS=180
# STALE_ORDER_SECONDS=60
# SELL_DISCOUNT_PCT=0.02
